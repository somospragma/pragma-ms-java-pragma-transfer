# Variables de entorno del servicio. Copiar a .env y completar (sin committear valores reales).
SERVICE_NAME=ms-transfers
SERVER_PORT=8080
AWS_REGION=us-east-1

# DynamoDB (en local: DynamoDB Local o LocalStack)
DYNAMODB_ENABLED=false
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_TRANSFERS=transfers
DYNAMODB_TABLE_IDEMPOTENCY=idempotency

# SNS transfers-events
SNS_ENABLED=false
SNS_TOPIC_ARN=

# Dependencias externas (WireMock)
CORE_BASE_URL=http://localhost:9090
FRAUD_BASE_URL=http://localhost:9091

# Secretos: la library los escribe en Secrets Manager (pipeline)
# En AWS las llaves salen del secreto SECRET_APIS_NAME; en local quedan en local-dev-key
SECRET_APIS_NAME=
CORE_API_KEY=local-dev-key
FRAUD_API_KEY=local-dev-key
